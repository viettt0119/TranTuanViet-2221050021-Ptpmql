@model IEnumerable<DemoMVC.Models.DepartmentModel>
@{ ViewData["Title"] = "Danh mục Khoa"; }
<h1>Danh mục Khoa</h1>
@if (TempData["Success"] is string message) { <div class="alert alert-success">@message</div> }
<p>Nhập danh mục Khoa của trường Đại học Mỏ - Địa chất. Mã Khoa do bài tập quy ước.</p>
<p><a asp-action="Create" class="btn btn-primary">Thêm Khoa</a> <a asp-controller="Student" asp-action="Index">Danh sách sinh viên</a></p>
<table class="table table-bordered">
    <thead><tr><th>Mã Khoa</th><th>Tên Khoa</th><th>Thao tác</th></tr></thead>
    <tbody>
    @foreach (var department in Model)
    {
        <tr>
            <td>@department.DepartmentCode</td><td>@department.DepartmentName</td>
            <td><a asp-action="Details" asp-route-id="@department.DepartmentCode">Chi tiết / Sinh viên</a> | <a asp-action="Edit" asp-route-id="@department.DepartmentCode">Sửa</a> | <a asp-action="Delete" asp-route-id="@department.DepartmentCode">Xóa</a></td>
        </tr>
    }
    </tbody>
</table>
