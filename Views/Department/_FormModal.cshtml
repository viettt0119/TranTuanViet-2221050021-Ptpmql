@model DemoMVC.Models.DepartmentModel
@{
    var title = (string)ViewData["ModalTitle"]!;
    var formActionUrl = (string)ViewData["FormActionUrl"]!;
    var isCreate = (bool)ViewData["IsCreate"]!;
}
<div class="modal fade" tabindex="-1" aria-labelledby="departmentModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="@formActionUrl" method="post" data-ajax-modal-form>
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="departmentModalTitle">@title</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    @if (isCreate)
                    {
                        <div class="mb-3">
                            <label asp-for="DepartmentCode" class="form-label"></label>
                            <input asp-for="DepartmentCode" class="form-control" />
                            <span asp-validation-for="DepartmentCode" class="text-danger"></span>
                        </div>
                    }
                    else
                    {
                        <input asp-for="DepartmentCode" type="hidden" />
                        <div class="mb-3">
                            <label asp-for="DepartmentCode" class="form-label"></label>
                            <input value="@Model.DepartmentCode" class="form-control" disabled />
                        </div>
                    }
                    <div class="mb-3">
                        <label asp-for="DepartmentName" class="form-label"></label>
                        <input asp-for="DepartmentName" class="form-control" />
                        <span asp-validation-for="DepartmentName" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>
