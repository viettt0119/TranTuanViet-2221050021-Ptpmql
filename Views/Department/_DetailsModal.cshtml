@model DemoMVC.Models.DepartmentModel
<div class="modal fade" tabindex="-1" aria-labelledby="departmentDetailsTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="departmentDetailsTitle">Khoa @Model.DepartmentName</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <p><strong>Mã Khoa:</strong> @Model.DepartmentCode</p>
                <h3 class="fs-6">Sinh viên thuộc Khoa</h3>
                @if (Model.Students.Count == 0)
                {
                    <p class="text-muted mb-0">Khoa chưa có sinh viên.</p>
                }
                else
                {
                    <ul class="mb-0">
                        @foreach (var student in Model.Students.OrderBy(student => student.StudentCode))
                        {
                            <li>@student.StudentCode — @student.FullName</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
