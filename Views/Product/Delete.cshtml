@model DemoMVC.Models.ProductModel

@{
    ViewData["Title"] = "Xóa Sản phẩm";
}

<div class="container mt-4">
    <div class="alert alert-danger shadow-sm">
        <h4 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Cảnh báo!</h4>
        <p>Bạn có chắc chắn muốn xóa vĩnh viễn sản phẩm này không? Hành động này không thể hoàn tác.</p>
        <hr>
        
        <dl class="row mb-0">
            <dt class="col-sm-3">Mã ID:</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Tên sản phẩm:</dt>
            <dd class="col-sm-9 fw-bold">@Model.Name</dd>

            <dt class="col-sm-3">Giá tiền:</dt>
            <dd class="col-sm-9 text-danger fw-bold">@Model.Price.ToString("N0") VNĐ</dd>
        </dl>
    </div>

    <form asp-action="Delete" method="post" class="mt-3">
        <!-- Trường ẩn giữ Id để gửi lên Controller -->
        <input type="hidden" asp-for="Id" />
        <a asp-action="Index" class="btn btn-outline-secondary me-2">Quay lại danh sách</a>
        <button type="submit" class="btn btn-danger">Xác nhận Xóa</button>
    </form>
</div>