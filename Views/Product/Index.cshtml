@model DemoMVC.Models.PagedList<DemoMVC.Models.ProductModel>
@{
    ViewData["Title"] = "Danh sách sản phẩm";
    var searchQuery = ViewData["SearchQuery"] as string;
}

<section class="list-page" data-crud-list>
    <div class="page-heading">
        <div>
            <span class="page-eyebrow">QUẢN LÝ KHO</span>
            <h1>Sản phẩm</h1>
            <p class="text-muted mb-0">Tra cứu sản phẩm và cập nhật danh mục hàng hóa.</p>
        </div>
        <a asp-permission="Product.Create" asp-action="Create" data-modal-url="@Url.Action("Create")" class="btn btn-primary">+ Thêm sản phẩm</a>
    </div>

    <div class="list-toolbar">
        <form asp-action="Index" method="get" class="search-form">
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <label class="visually-hidden" for="product-search">Tìm sản phẩm</label>
            <input id="product-search" name="q" value="@searchQuery" class="form-control" placeholder="Tìm theo tên sản phẩm..." />
            <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
            @if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                <a asp-action="Index" asp-route-pageSize="@Model.PageSize" data-list-url class="btn btn-link">Xóa lọc</a>
            }
        </form>
    </div>

    <div class="table-responsive list-card">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr><th class="text-center">ID</th><th>Tên sản phẩm</th><th class="text-end">Giá (VNĐ)</th><th class="text-end">Thao tác</th></tr>
            </thead>
            <tbody>
            @if (Model.Items.Count > 0)
            {
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="text-center"><span class="code-chip">@item.Id</span></td>
                        <td class="fw-semibold">@item.Name</td>
                        <td class="text-end">@item.Price.ToString("N0")</td>
                        <td class="text-end text-nowrap">
                            <a asp-permission="Product.Details" asp-action="Details" asp-route-id="@item.Id" data-modal-url="@Url.Action("Details", new { id = item.Id })" class="btn btn-sm btn-outline-info">Chi tiết</a>
                            <a asp-permission="Product.Edit" asp-action="Edit" asp-route-id="@item.Id" data-modal-url="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-outline-warning">Sửa</a>
                            <a asp-permission="Product.Delete" asp-action="Delete" asp-route-id="@item.Id" data-modal-url="@Url.Action("Delete", new { id = item.Id })" class="btn btn-sm btn-outline-danger">Xóa</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="4" class="empty-state">@(string.IsNullOrWhiteSpace(searchQuery) ? "Chưa có sản phẩm nào." : "Không tìm thấy sản phẩm phù hợp.")</td></tr>
            }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_PagedListFooter", (object)Model)
</section>
@await Html.PartialAsync("_CrudModalHost")
