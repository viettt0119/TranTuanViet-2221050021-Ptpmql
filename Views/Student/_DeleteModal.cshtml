@model DemoMVC.Models.ViewModels.Students.StudentDetailsViewModel
@{
    var formActionUrl = (string)ViewData["FormActionUrl"]!;
}
<div class="modal fade" tabindex="-1" aria-labelledby="deleteStudentTitle" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <form action="@formActionUrl" method="post" data-ajax-modal-form>
            @Html.AntiForgeryToken()
            <input name="concurrencyStamp" type="hidden" value="@Model.ConcurrencyStamp" />
            <div class="modal-header"><h2 class="modal-title fs-5" id="deleteStudentTitle">Xoá sinh viên</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body"><div asp-validation-summary="All" class="text-danger"></div><div class="alert alert-danger"><strong>Cảnh báo:</strong> Bạn có chắc muốn xoá <strong>@Model.StudentCode — @Model.FullName</strong> thuộc khoa <strong>@Model.DepartmentName</strong> không?</div><p class="mb-0">Số thứ tự đã cấp sẽ không được dùng lại.</p></div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Huỷ</button><button type="submit" class="btn btn-danger">Xoá</button></div>
        </form>
    </div></div>
</div>
