@model DemoMVC.Models.StudentModel
@{ ViewData["Title"] = "Chi tiết sinh viên"; }
<h1>@Model.StudentCode</h1>
<dl>
    <dt>Họ tên</dt><dd>@Model.FullName</dd>
    <dt>Địa chỉ</dt><dd>@Model.Address</dd>
    <dt>Trường</dt><dd>@Model.University</dd>
    <dt>Khoa</dt><dd>@Model.Department?.DepartmentName (@Model.DepartmentCode)</dd>
    <dt>Năm nhập học</dt><dd>@Model.AdmissionYear</dd>
    <dt>Mã hệ</dt><dd>@Model.TrainingSystemCode</dd>
    <dt>Mã ngành</dt><dd>@Model.MajorCode</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.Id">Sửa</a> | <a asp-action="Index">Quay lại</a>
