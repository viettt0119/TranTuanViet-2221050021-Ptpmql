@model DemoMVC.Models.StudentModel
@{ ViewData["Title"] = "Thêm sinh viên"; }
<h1>Thêm sinh viên</h1>
<p>---------------</p>
@if (!(bool)ViewBag.HasDepartments)
{
    <div class="alert alert-warning">Chưa có Khoa. <a asp-controller="Department" asp-action="Create">Thêm Khoa</a> trước khi lưu sinh viên.</div>
}
<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="FullName">Họ tên</label><input asp-for="FullName" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Address">Địa chỉ</label><input asp-for="Address" class="form-control" /></div>
    <div class="mb-3"><label asp-for="University">Trường</label><input asp-for="University" class="form-control" /></div>
    <div class="mb-3">
        <label asp-for="DepartmentCode">Khoa</label>
        <select asp-for="DepartmentCode" asp-items="ViewBag.DepartmentCode" class="form-select">
            <option value="">-- Chọn Khoa --</option>
        </select>
    </div>
    <div class="mb-3"><label asp-for="AdmissionYear">Năm nhập học</label><input asp-for="AdmissionYear" class="form-control" /></div>
    <div class="mb-3"><label asp-for="TrainingSystemCode">Mã hệ (2 chữ số)</label><input asp-for="TrainingSystemCode" class="form-control" maxlength="2" /></div>
    <div class="mb-3"><label asp-for="MajorCode">Mã ngành (2 chữ số)</label><input asp-for="MajorCode" class="form-control" maxlength="2" /></div>
    <p>----------</p>
    <button class="btn btn-primary" type="submit" disabled="@(!(bool)ViewBag.HasDepartments)">Lưu sinh viên</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
