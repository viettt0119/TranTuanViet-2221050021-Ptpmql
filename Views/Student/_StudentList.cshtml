@model DemoMVC.Models.ViewModels.Students.StudentIndexViewModel
@{
    ViewData["SearchQuery"] = Model.Filter.Q;
    ViewData["PagingRouteValues"] = new Dictionary<string, string?>
    {
        ["departmentCode"] = Model.Filter.DepartmentCode,
        ["admissionYear"] = Model.Filter.AdmissionYear?.ToString(),
        ["sort"] = Model.Filter.Sort,
        ["dir"] = Model.Filter.Dir
    };
}
<section class="list-page" data-crud-list>
    <div class="page-heading">
        <div><span class="page-eyebrow">QUẢN LÝ ĐÀO TẠO</span><h1>Sinh viên</h1><p class="text-muted mb-0">Tra cứu và quản lý hồ sơ sinh viên.</p></div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-permission="Student.Export" asp-action="Export" asp-route-q="@Model.Filter.Q" asp-route-departmentCode="@Model.Filter.DepartmentCode" asp-route-admissionYear="@Model.Filter.AdmissionYear" asp-route-sort="@Model.Filter.Sort" asp-route-dir="@Model.Filter.Dir" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel</a>
            <a asp-permission="ExcelImport.Index" asp-controller="ExcelImport" asp-action="Index" asp-route-entity="student" class="btn btn-outline-primary">Nhập Excel</a>
            <a asp-permission="Student.Create" asp-action="Create" data-modal-url="@Url.Action("Create")" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Thêm sinh viên</a>
        </div>
    </div>
    <form asp-action="Index" method="get" class="card p-3 mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-lg-4"><label for="student-search" class="form-label">Tìm kiếm</label><input id="student-search" name="q" value="@Model.Filter.Q" class="form-control" placeholder="Tìm mã, họ tên hoặc email..." /></div>
            <div class="col-lg-3"><label for="student-department" class="form-label">Khoa</label><select id="student-department" name="departmentCode" class="form-select"><option value="">Tất cả khoa</option>@foreach (var department in Model.Departments) { <option value="@department.DepartmentCode" selected="@(Model.Filter.DepartmentCode == department.DepartmentCode)">@department.DepartmentName</option> }</select></div>
            <div class="col-lg-2"><label for="student-year" class="form-label">Năm nhập học</label><select id="student-year" name="admissionYear" class="form-select"><option value="">Tất cả năm</option>@foreach (var year in Model.AdmissionYears) { <option value="@year" selected="@(Model.Filter.AdmissionYear == year)">@year</option> }</select></div>
            <input type="hidden" name="sort" value="@Model.Filter.Sort" /><input type="hidden" name="dir" value="@Model.Filter.Dir" />
            <input type="hidden" name="pageSize" value="@Model.Students.PageSize" />
            <div class="col-lg-3 d-flex gap-2"><button class="btn btn-primary" type="submit"><i class="bi bi-funnel me-1"></i>Lọc</button><a asp-action="Index" asp-route-pageSize="@Model.Students.PageSize" data-list-url class="btn btn-outline-secondary">Xoá lọc</a></div>
        </div>
    </form>
    @await Html.PartialAsync("_StudentTable", Model)
    @await Html.PartialAsync("_PagedListFooter", (object)Model.Students)
</section>
