@model DemoMVC.Models.StudentModel
@{ ViewData["Title"] = "Sửa sinh viên"; }
<h1>Sửa sinh viên @Model.StudentCode</h1>
<p>Mã, năm nhập học, hệ và ngành được giữ nguyên. Bạn có thể sửa thông tin cá nhân và Khoa quản lý.</p>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="FullName">Họ tên</label><input asp-for="FullName" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Address">Địa chỉ</label><input asp-for="Address" class="form-control" /></div>
    <div class="mb-3"><label asp-for="University">Trường</label><input asp-for="University" class="form-control" /></div>
    <div class="mb-3">
        <label asp-for="DepartmentCode"></label>
        <select asp-for="DepartmentCode" asp-items="ViewBag.DepartmentCode" class="form-select"><option value="">-- Chọn Khoa --</option></select>
    </div>
    <div class="alert alert-info">Năm: @Model.AdmissionYear — Hệ: @Model.TrainingSystemCode — Ngành: @Model.MajorCode</div>
    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index">Quay lại</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
