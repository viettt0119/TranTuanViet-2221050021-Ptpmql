@model DemoMVC.Models.StudentModel
@{ ViewData["Title"] = "Xóa sinh viên"; }
<h1>Xóa sinh viên</h1>
<div asp-validation-summary="All" class="text-danger"></div>
<p>Xác nhận xóa @Model.FullName — @Model.StudentCode?</p>
<p>Số thứ tự đã cấp được giữ lại trong bộ đếm, không được tái sử dụng.</p>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a asp-action="Index">Hủy</a>
</form>
