@model DemoMVC.Models.PagedList<DemoMVC.Models.LessonCatalogItem>
@{
    ViewData["Title"] = "Xem lại bài học";
    var searchQuery = ViewData["SearchQuery"] as string;
    var lectureFilter = ViewData["LectureFilter"] as int?;
    ViewData["PagingRouteValues"] = new Dictionary<string, string?> { ["lecture"] = lectureFilter?.ToString() };
    var hasFilter = !string.IsNullOrWhiteSpace(searchQuery) || lectureFilter is not null;
}
@section Breadcrumb {
    <ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Dashboard">Trang chủ</a></li><li class="breadcrumb-item active">Xem lại bài học</li></ol>
}

<section class="list-page" data-crud-list>
    <div class="page-heading">
        <div>
            <span class="page-eyebrow">BÀI HỌC · CHỈ DÀNH CHO QUẢN TRỊ VIÊN</span>
            <h1>Xem lại bài học Lec 1 – Lec 6</h1>
            <p class="text-muted mb-0">Các bài giảng và bài thực hành nhỏ lẻ của môn học, tách riêng khỏi phần quản lý.</p>
        </div>
    </div>

    <div class="list-toolbar">
        <form asp-action="Index" method="get" class="search-form">
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <label class="visually-hidden" for="lesson-search">Tìm bài học</label>
            <input id="lesson-search" name="q" value="@searchQuery" class="form-control" placeholder="Tìm theo tên bài, chủ đề (VD: routing, EF Core)..." />
            <label class="visually-hidden" for="lesson-lecture">Lọc theo buổi</label>
            <select id="lesson-lecture" name="lecture" class="form-select w-auto">
                <option value="">Tất cả các buổi</option>
                @for (var lecture = 1; lecture <= 6; lecture++)
                {
                    <option value="@lecture" selected="@(lecture == lectureFilter)">Lec @lecture</option>
                }
            </select>
            <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
            @if (hasFilter)
            {
                <a asp-action="Index" asp-route-pageSize="@Model.PageSize" data-list-url class="btn btn-link">Xóa lọc</a>
            }
        </form>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="list-card empty-state">
            <i class="bi bi-journal-x"></i>
            Không tìm thấy bài học phù hợp.
        </div>
    }
    else
    {
        <div class="row g-3 lesson-grid">
            @foreach (var item in Model.Items)
            {
                <div class="col-md-6 col-xl-4">
                    <a class="card h-100 lesson-card text-decoration-none" asp-controller="@item.Controller" asp-action="@item.Action">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <span class="lesson-card-icon"><i class="bi @item.Icon"></i></span>
                                <span class="badge text-bg-primary">Lec @item.Lecture</span>
                                <span class="badge @(item.Kind == "Thực hành" ? "text-bg-success" : "text-bg-secondary")">@item.Kind</span>
                            </div>
                            <h2 class="h5 mb-2">@item.Title</h2>
                            <p class="text-muted small flex-grow-1">@item.Summary</p>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var topic in item.Topics)
                                {
                                    <span class="code-chip small">@topic</span>
                                }
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
    @await Html.PartialAsync("_PagedListFooter", (object)Model)
</section>
