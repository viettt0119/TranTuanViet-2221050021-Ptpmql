@model DemoMVC.Models.ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đặt lại mật khẩu";
}
<div class="auth-page">
    <section class="auth-card">
        <div class="auth-intro">
            <span class="auth-eyebrow">KHÔI PHỤC TÀI KHOẢN</span>
            <h1>Đặt lại mật khẩu</h1>
            <p>Nhập mật khẩu mới cho tài khoản <strong>@Model.Email</strong>.</p>
        </div>
        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input asp-for="UserId" type="hidden" />
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Mật khẩu mới</label>
                <input asp-for="Password" class="form-control form-control-lg" autocomplete="new-password" />
                <div class="form-text">Tối thiểu 12 ký tự, gồm chữ hoa, chữ thường, chữ số và ký tự đặc biệt.</div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu</label>
                <input asp-for="ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100">Đặt lại mật khẩu</button>
        </form>
        <div class="auth-links">
            <a asp-action="ForgotPassword">Yêu cầu liên kết mới</a>
            <a asp-action="Login">Quay lại đăng nhập</a>
        </div>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
