@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đặt lại mật khẩu thành công";
}
<div class="auth-page">
    <section class="auth-card auth-success">
        <div class="auth-success-icon" aria-hidden="true">✓</div>
        <span class="auth-eyebrow">HOÀN TẤT</span>
        <h1>Mật khẩu đã được đặt lại</h1>
        <p>Bạn có thể đăng nhập bằng mật khẩu mới.</p>
        <a asp-action="Login" class="btn btn-primary btn-lg w-100">Đăng nhập</a>
    </section>
</div>
