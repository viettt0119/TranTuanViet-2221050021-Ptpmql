@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Liên kết không hợp lệ";
}
<div class="auth-page">
    <section class="auth-card auth-success">
        <div class="auth-success-icon auth-warning-icon" aria-hidden="true">!</div>
        <span class="auth-eyebrow">KHÔNG THỂ ĐẶT LẠI MẬT KHẨU</span>
        <h1>Liên kết không hợp lệ</h1>
        <p>Liên kết đặt lại mật khẩu không hợp lệ hoặc đã hết hạn. Hãy yêu cầu hướng dẫn mới.</p>
        <a asp-action="ForgotPassword" class="btn btn-primary btn-lg w-100">Quên mật khẩu</a>
    </section>
</div>
