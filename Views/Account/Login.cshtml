@model DemoMVC.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="auth-page">
    <section class="auth-card">
        <div class="auth-intro">
            <span class="auth-eyebrow">DemoMVC</span>
            <h1>Chào mừng trở lại</h1>
            <p>Đăng nhập để tiếp tục quản lý dữ liệu của bạn.</p>
        </div>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input asp-for="ReturnUrl" type="hidden" />
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control form-control-lg" autocomplete="username" placeholder="name@example.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Mật khẩu</label>
                <input asp-for="Password" class="form-control form-control-lg" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100">Đăng nhập</button>
        </form>
        <div class="auth-links">
            <a asp-action="ForgotPassword">Quên mật khẩu?</a>
            <span>Chưa có tài khoản? <a asp-action="Register">Đăng ký</a></span>
        </div>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
