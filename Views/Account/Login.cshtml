@model DemoMVC.Models.LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đăng nhập tài khoản";
}

<div class="auth-page">
    <section class="auth-card auth-card-wide">
        <div class="auth-header">
            <span class="auth-header-icon bg-primary"><i class="bi bi-shield-lock-fill" aria-hidden="true"></i></span>
            <h1>Đăng nhập tài khoản</h1>
            <p>Sử dụng tài khoản HUMG để đăng nhập</p>
        </div>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
            @if (ViewData["ShowResendConfirmation"] as bool? == true)
            {
                <div class="mb-3">
                    <a asp-action="ResendConfirmation" asp-route-email="@Model.Email" class="btn btn-outline-primary w-100">Gửi lại email xác thực</a>
                </div>
            }
            <input asp-for="ReturnUrl" type="hidden" />

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold">Email</label>
                <div class="input-group input-group-lg">
                    <span class="input-group-text"><i class="bi bi-envelope" aria-hidden="true"></i></span>
                    <input asp-for="Email" class="form-control" autocomplete="username" placeholder="name@humg.edu.vn" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-semibold">Mật khẩu</label>
                <input asp-for="Password" class="form-control form-control-lg" autocomplete="current-password" placeholder="Nhập mật khẩu..." />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="form-check mb-0">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
                </div>
                <a asp-action="ForgotPassword" class="fw-semibold text-decoration-none">Quên mật khẩu?</a>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100 auth-submit">
                <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Đăng nhập
            </button>
        </form>
        <div class="auth-footer">
            <span>Chưa có tài khoản? <a asp-action="Register">Đăng ký tài khoản mới</a></span>
            <a asp-action="ResendConfirmation" class="text-muted"><i class="bi bi-envelope-paper me-1" aria-hidden="true"></i>Gửi lại email xác thực</a>
        </div>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
