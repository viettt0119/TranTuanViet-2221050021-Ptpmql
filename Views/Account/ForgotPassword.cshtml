@model DemoMVC.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}
<h1>Quên mật khẩu</h1>
<p>Nhập email đã đăng ký. Nếu tài khoản phù hợp tồn tại, hướng dẫn sẽ được gửi tới email đó.</p>
<form asp-action="ForgotPassword" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Gửi hướng dẫn</button>
</form>
