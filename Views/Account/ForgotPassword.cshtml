@model DemoMVC.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}
<div class="auth-page">
    <section class="auth-card">
        <div class="auth-intro">
            <span class="auth-eyebrow">KHÔI PHỤC TÀI KHOẢN</span>
            <h1>Quên mật khẩu</h1>
            <p>Nhập email đã đăng ký. Nếu tài khoản phù hợp tồn tại, liên kết đặt lại mật khẩu (hiệu lực 1 giờ) sẽ được gửi tới email đó.</p>
        </div>
        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control form-control-lg" autocomplete="email" placeholder="name@gmail.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100">Gửi hướng dẫn</button>
        </form>
        <div class="auth-links">
            <a asp-action="Login">Quay lại đăng nhập</a>
        </div>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
