@model Microsoft.AspNetCore.Identity.IdentityRole
@{
    var userCount = ViewData["UserCount"] as int? ?? 0;
}
<div class="modal fade" tabindex="-1" aria-labelledby="roleDeleteTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="@Url.Action("Delete", new { id = Model.Id })" method="post" data-ajax-modal-form>
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="roleDeleteTitle">Xóa vai trò</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <p>Bạn có chắc muốn xóa vai trò <strong>@Model.Name</strong> không? Toàn bộ quyền của vai trò cũng bị xóa.</p>
                    @if (userCount > 0)
                    {
                        <div class="alert alert-warning mb-0">Vai trò đang được gán cho @userCount người dùng nên chưa thể xóa.</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger" disabled="@(userCount > 0)">Xóa</button>
                </div>
            </form>
        </div>
    </div>
</div>
