@model DemoMVC.Models.PagedList<DemoMVC.Controllers.RoleController.RoleRow>
@{
    ViewData["Title"] = "Quản lý vai trò";
    var searchQuery = ViewData["SearchQuery"] as string;
    var totalPermissions = ViewData["TotalPermissions"] as int? ?? 0;
}

<section class="list-page">
    <div class="page-heading">
        <div>
            <span class="page-eyebrow">HỆ THỐNG</span>
            <h1>Vai trò</h1>
            <p class="text-muted mb-0">Tạo vai trò và phân quyền động cho từng action của mọi controller.</p>
        </div>
        <a asp-action="Create" data-modal-url="@Url.Action("Create")" class="btn btn-primary" asp-permission="Role.Create">+ Thêm vai trò</a>
    </div>

    <div class="list-toolbar">
        <form asp-action="Index" method="get" class="search-form">
            <label class="visually-hidden" for="role-search">Tìm vai trò</label>
            <input id="role-search" name="q" value="@searchQuery" class="form-control" placeholder="Tìm theo tên vai trò..." />
            <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
            @if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                <a asp-action="Index" class="btn btn-link">Xóa lọc</a>
            }
        </form>
    </div>

    <div data-crud-list>
        <div class="table-responsive list-card">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr><th>Tên vai trò</th><th>Người dùng</th><th>Quyền được cấp</th><th class="text-end">Thao tác</th></tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr><td colspan="4" class="empty-state">@(string.IsNullOrWhiteSpace(searchQuery) ? "Chưa có vai trò nào." : "Không tìm thấy vai trò phù hợp.")</td></tr>
                    }
                    @foreach (var role in Model.Items)
                    {
                        var isAdmin = string.Equals(role.Name, "Admin", StringComparison.OrdinalIgnoreCase);
                        <tr>
                            <td class="fw-semibold">
                                @role.Name
                                @if (isAdmin) { <span class="badge text-bg-dark ms-1">Hệ thống</span> }
                            </td>
                            <td>@role.UserCount</td>
                            <td>@(isAdmin ? "Toàn bộ" : $"{role.GrantedCount}/{totalPermissions}")</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@role.Id" data-modal-url="@Url.Action("Details", new { id = role.Id })" class="btn btn-sm btn-outline-info" asp-permission="Role.Details">Chi tiết</a>
                                <a asp-action="Permissions" asp-route-id="@role.Id" data-modal-url="@Url.Action("Permissions", new { id = role.Id })" class="btn btn-sm btn-outline-primary" asp-permission="Role.Permissions">Phân quyền</a>
                                @if (!isAdmin)
                                {
                                    <a asp-action="Edit" asp-route-id="@role.Id" data-modal-url="@Url.Action("Edit", new { id = role.Id })" class="btn btn-sm btn-outline-warning" asp-permission="Role.Edit">Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@role.Id" data-modal-url="@Url.Action("Delete", new { id = role.Id })" class="btn btn-sm btn-outline-danger" asp-permission="Role.Delete">Xóa</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_PagedListFooter", (object)Model)
    </div>
</section>
@await Html.PartialAsync("_CrudModalHost")
