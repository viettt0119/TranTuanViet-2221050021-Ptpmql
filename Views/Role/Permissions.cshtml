@model List<DemoMVC.Controllers.RoleController.PermissionMatrixItem>
@{
    ViewData["Title"] = "Phân quyền vai trò";
    var role = ViewBag.Role as Microsoft.AspNetCore.Identity.IdentityRole;
}

<h2>Phân quyền cho @role?.Name</h2>

<form asp-action="Permissions" asp-route-id="@role?.Id" method="post">
    @Html.AntiForgeryToken()
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th style="width: 5%;">Chọn</th>
                <th>Tên quyền</th>
                <th>Key</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var permission in Model)
            {
                <tr>
                    <td>
                        <input type="checkbox" name="selectedPermissions" value="@permission.PermissionId" checked="@(permission.IsGranted ? "checked" : null)" />
                    </td>
                    <td>@permission.Name</td>
                    <td>@permission.PermissionKey</td>
                </tr>
            }
        </tbody>
    </table>
    <button type="submit" class="btn btn-primary">Lưu quyền</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>
