@inject DemoMVC.Services.PermissionCatalogService PermissionCatalogService
@{
    var canStudent = await PermissionCatalogService.HasAccessAsync(User, "Student.Index");
    var canDepartment = await PermissionCatalogService.HasAccessAsync(User, "Department.Index");
    var canEmployee = await PermissionCatalogService.HasAccessAsync(User, "Employee.Index");
    var canProduct = await PermissionCatalogService.HasAccessAsync(User, "Product.Index");
    var canExcel = await PermissionCatalogService.HasAccessAsync(User, "ExcelImport.Index");
    var canUser = await PermissionCatalogService.HasAccessAsync(User, "UserManagement.Index");
    var canRole = await PermissionCatalogService.HasAccessAsync(User, "Role.Index");
}
<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HUMG</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/my-css.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DemoMVC.styles.css" asp-append-version="true" />
</head>
<body>
    <aside class="app-sidebar" id="app-sidebar">
        <a asp-controller="Home" asp-action="Dashboard" class="sidebar-brand">
            <i class="bi bi-mortarboard-fill me-2"></i><span class="brand-text">HUMG</span>
        </a>
        <nav class="sidebar-nav">
            <a asp-controller="Home" asp-action="Dashboard" class="sidebar-link"><i class="bi bi-house-door"></i><span class="sidebar-label">Tổng quan</span></a>
            @if (canStudent || canDepartment)
            {
                <div class="sidebar-heading">Đào tạo</div>
                @if (canStudent) { <a asp-controller="Student" asp-action="Index" class="sidebar-link"><i class="bi bi-person-badge"></i><span class="sidebar-label">Sinh viên</span></a> }
                @if (canDepartment) { <a asp-controller="Department" asp-action="Index" class="sidebar-link"><i class="bi bi-buildings"></i><span class="sidebar-label">Khoa</span></a> }
            }
            @if (canEmployee) { <div class="sidebar-heading">Nhân sự</div><a asp-controller="Employee" asp-action="Index" class="sidebar-link"><i class="bi bi-people"></i><span class="sidebar-label">Nhân viên</span></a> }
            @if (canProduct) { <div class="sidebar-heading">Kinh doanh</div><a asp-controller="Product" asp-action="Index" class="sidebar-link"><i class="bi bi-box-seam"></i><span class="sidebar-label">Sản phẩm</span></a> }
            @if (canExcel || canUser || canRole)
            {
                <div class="sidebar-heading">Hệ thống</div>
                @if (canExcel) { <a asp-controller="ExcelImport" asp-action="Index" class="sidebar-link"><i class="bi bi-file-earmark-excel"></i><span class="sidebar-label">Nhập Excel</span></a> }
                @if (canUser) { <a asp-controller="UserManagement" asp-action="Index" class="sidebar-link"><i class="bi bi-person-gear"></i><span class="sidebar-label">Người dùng</span></a> }
                @if (canRole) { <a asp-controller="Role" asp-action="Index" class="sidebar-link"><i class="bi bi-shield-check"></i><span class="sidebar-label">Vai trò</span></a> }
            }
        </nav>
    </aside>
    <div class="app-main" id="app-main">
        <header class="topbar">
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-secondary d-lg-none" id="mobile-sidebar" type="button"><i class="bi bi-list"></i></button>
                <button class="btn btn-outline-secondary d-none d-lg-inline-flex" id="collapse-sidebar" type="button"><i class="bi bi-layout-sidebar"></i></button>
                <nav aria-label="breadcrumb">@await RenderSectionAsync("Breadcrumb", required: false)</nav>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-secondary" id="theme-toggle" type="button" title="Chuyển sáng/tối"><i class="bi bi-moon-stars"></i></button>
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">@User.Identity?.Name</button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2"></i>Đổi mật khẩu</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button></form></li>
                    </ul>
                </div>
            </div>
        </header>
        <main class="app-content">@RenderBody()</main>
    </div>
    <div class="toast-container position-fixed top-0 end-0 p-3" id="toast-container"></div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
    <script src="~/js/crud-modal.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
