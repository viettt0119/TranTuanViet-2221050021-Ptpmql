@inject DemoMVC.Services.PermissionCatalogService PermissionCatalogService
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DemoMVC</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/my-css.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DemoMVC.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-4 app-navbar">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">DemoMVC</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-sm-center">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true && await PermissionCatalogService.HasAccessAsync(User, "Student.Index"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Student" asp-action="Index">Sinh viên</a>
                            </li>
                        }
                        @if (User.Identity?.IsAuthenticated == true && await PermissionCatalogService.HasAccessAsync(User, "Department.Index"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Department" asp-action="Index">Khoa</a>
                            </li>
                        }
                        @if (User.Identity?.IsAuthenticated == true && await PermissionCatalogService.HasAccessAsync(User, "Product.Index"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Product" asp-action="Index">Sản phẩm</a>
                            </li>
                        }
                        @if (User.Identity?.IsAuthenticated == true && await PermissionCatalogService.HasAccessAsync(User, "Employee.Index"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Employee" asp-action="Index">Nhân viên</a>
                            </li>
                        }
                        @if (User.Identity?.IsAuthenticated == true && await PermissionCatalogService.HasAccessAsync(User, "Role.Index"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Role" asp-action="Index">Vai trò</a>
                            </li>
                        }
                        @if (User.Identity?.IsAuthenticated == true && await PermissionCatalogService.HasAccessAsync(User, "UserManagement.Index"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="UserManagement" asp-action="Index">Người dùng</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="ChangePassword">Đổi mật khẩu</a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-link text-dark">Đăng xuất (@User.Identity.Name)</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Đăng ký</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/crud-modal.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
