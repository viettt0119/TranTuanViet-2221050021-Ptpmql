@model ErrorViewModel
@{
    // Trang lỗi 500 không dùng _Layout: layout truy vấn CSDL để kiểm tra quyền, nếu lỗi do CSDL thì trang lỗi cũng hỏng theo.
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đã xảy ra lỗi - DemoMVC</title>
    <link rel="stylesheet" href="~/lib/architectui/architectui.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/my-css.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-page">
        <section class="auth-card auth-success">
            <div class="auth-success-icon auth-warning-icon" aria-hidden="true">!</div>
            <span class="auth-eyebrow">LỖI HỆ THỐNG</span>
            <h1>Đã xảy ra lỗi</h1>
            <p>Hệ thống gặp sự cố khi xử lý yêu cầu của bạn. Vui lòng thử lại sau ít phút.</p>
            @if (Model?.ShowRequestId == true)
            {
                <p class="small">Mã yêu cầu (gửi cho quản trị viên khi cần hỗ trợ): <code>@Model.RequestId</code></p>
            }
            <a href="~/" class="btn btn-primary btn-lg w-100">Về trang chủ</a>
        </section>
    </div>
</body>
</html>
