@model DemoMVC.Models.ApplicationUser
@{
    var roles = ViewData["Roles"] as List<string> ?? [];
    var isLockedOut = ViewData["IsLockedOut"] as bool? == true;
}
<div class="modal fade" tabindex="-1" aria-labelledby="userDetailsTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="userDetailsTitle">Người dùng @Model.Email</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Họ tên</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.FullName) ? "—" : Model.FullName)</dd>
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">Xác thực email</dt>
                    <dd class="col-sm-8">
                        @if (Model.EmailConfirmed)
                        {
                            <span class="badge text-bg-success">Đã xác thực</span>
                        }
                        else
                        {
                            <span class="badge text-bg-warning">Chưa xác thực</span>
                        }
                    </dd>
                    <dt class="col-sm-4">Trạng thái</dt>
                    <dd class="col-sm-8">@(isLockedOut ? "Đang bị khoá" : "Hoạt động")</dd>
                    <dt class="col-sm-4">Vai trò</dt>
                    <dd class="col-sm-8">@(roles.Count == 0 ? "—" : string.Join(", ", roles))</dd>
                </dl>
            </div>
            <div class="modal-footer">
                @if (!Model.EmailConfirmed)
                {
                    <form action="@Url.Action("ConfirmEmail", new { id = Model.Id })" method="post" data-ajax-modal-form class="me-auto" asp-permission="UserManagement.ConfirmEmail">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-success">Xác thực email thủ công</button>
                    </form>
                }
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>
