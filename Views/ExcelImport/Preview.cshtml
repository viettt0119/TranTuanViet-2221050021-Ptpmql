@model DemoMVC.Models.ExcelImportPreview
@{
    ViewData["Title"] = "Xem trước nhập Excel";
}
<section class="list-page">
    <div class="page-heading">
        <div><span class="page-eyebrow">XÁC NHẬN DỮ LIỆU</span><h1>Xem trước nhập Excel</h1></div>
    </div>
    <div class="list-card p-4">
        <p>Tổng dòng: <strong>@Model.Total</strong> | Hợp lệ: <strong>@Model.Valid</strong> | Dòng mới: <strong>@Model.NewCount</strong> | Dòng trùng: <strong>@Model.DuplicateCount</strong></p>
        @if (Model.Errors.Count > 0)
        {
            <div class="alert alert-danger">
                <strong>Không thể thực thi các dòng lỗi:</strong>
                <ul>@foreach (var error in Model.Errors) { <li>Dòng @error.Row: @error.Message</li> }</ul>
            </div>
        }
        <form asp-action="Confirm" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="previewToken" value="@Model.Token" />
            @if (Model.DuplicateCount > 0)
            {
                <fieldset class="mb-3">
                    <legend class="form-label">Khi gặp dữ liệu trùng khoá</legend>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="mode" id="append" value="Append" checked />
                        <label class="form-check-label" for="append">Ghi bổ sung — bỏ qua @Model.DuplicateCount dòng trùng</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="mode" id="overwrite" value="Overwrite" />
                        <label class="form-check-label" for="overwrite">Ghi đè — cập nhật @Model.DuplicateCount dòng trùng</label>
                    </div>
                </fieldset>
            }
            else
            {
                <input type="hidden" name="mode" value="Append" />
            }
            <button type="submit" class="btn btn-primary" @(Model.Valid == 0 ? "disabled" : null)>Xác nhận nhập dữ liệu</button>
            <a asp-action="Index" class="btn btn-secondary">Huỷ</a>
        </form>
    </div>
</section>
