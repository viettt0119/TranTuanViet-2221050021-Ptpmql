@model DemoMVC.Models.ExcelImportPreview
@{
    ViewData["Title"] = "Xem trước nhập Excel";
    var canAppend = Model.CanAppend && Model.Valid > 0;
    var canOverwrite = Model.CanOverwrite && Model.Valid > 0;
    var canSubmit = Model.DuplicateCount > 0 ? canAppend || canOverwrite : canAppend;
    var labels = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["DepartmentName"] = "Tên Khoa",
        ["DepartmentCode"] = "Mã Khoa",
        ["FullName"] = "Họ tên",
        ["HireDate"] = "Ngày vào làm",
        ["Name"] = "Tên sản phẩm",
        ["Price"] = "Giá",
        ["Address"] = "Địa chỉ",
        ["University"] = "Trường",
        ["Email"] = "Email",
        ["PhoneNumber"] = "Số điện thoại",
        ["DateOfBirth"] = "Ngày sinh",
        ["Gender"] = "Giới tính",
        ["IsGranted"] = "Cấp quyền"
    };
    string Show(string value) => string.IsNullOrWhiteSpace(value) ? "(trống)" : value;
}
<section class="list-page">
    <div class="page-heading">
        <div><span class="page-eyebrow">XÁC NHẬN DỮ LIỆU</span><h1>Xem trước nhập Excel</h1></div>
    </div>
    <div class="list-card p-4">
        <p>Tổng dòng: <strong>@Model.Total</strong> | Hợp lệ: <strong>@Model.Valid</strong> | Dòng mới: <strong>@Model.NewCount</strong> | Dòng trùng: <strong>@Model.DuplicateCount</strong> | Dòng lỗi: <strong>@Model.Errors.Count</strong></p>
        <p class="text-muted">Chưa có dữ liệu nào được ghi. Hãy kiểm tra các dòng dưới đây trước khi xác nhận.</p>
        @if (Model.Errors.Count > 0)
        {
            <div class="alert alert-danger">
                <strong>Các dòng lỗi sẽ không được nhập:</strong>
                <ul class="mb-0">@foreach (var error in Model.Errors) { <li>Dòng @error.Row: @error.Message</li> }</ul>
            </div>
        }
        @if (Model.Rows.Count > 0)
        {
            <div class="table-responsive border rounded mb-3 import-preview" tabindex="0" aria-label="Các dòng hợp lệ">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Dòng</th><th>Trạng thái</th><th>Dữ liệu trong file</th><th>Thay đổi nếu ghi đè</th></tr></thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var changes = DemoMVC.Services.ExcelImportService.DescribeOverwrite(Model.Entity, row);
                            <tr>
                                <td>@row.RowNumber</td>
                                <td>
                                    @if (row.IsExisting)
                                    {
                                        <span class="badge text-bg-warning">Trùng</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-success">Mới</span>
                                    }
                                </td>
                                <td>@string.Join(" · ", row.Values.Values.Where(value => !string.IsNullOrWhiteSpace(value)))</td>
                                <td>
                                    @if (!row.IsExisting)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else if (changes.Count == 0)
                                    {
                                        <span class="text-muted">Không có trường nào thay đổi</span>
                                    }
                                    else
                                    {
                                        foreach (var change in changes)
                                        {
                                            <div><strong>@labels.GetValueOrDefault(change.Field, change.Field):</strong> <del class="text-muted">@Show(change.OldValue)</del> → @Show(change.NewValue)</div>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <form asp-action="Confirm" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="previewToken" value="@Model.Token" />
            @if (Model.DuplicateCount > 0)
            {
                <fieldset class="mb-3">
                    <legend class="form-label fs-6">Khi gặp dữ liệu trùng khoá</legend>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="mode" id="append" value="Append" checked="@canAppend" disabled="@(!canAppend)" />
                        <label class="form-check-label" for="append">Ghi bổ sung — thêm @Model.NewCount dòng mới, bỏ qua @Model.DuplicateCount dòng trùng</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="mode" id="overwrite" value="Overwrite" checked="@(!canAppend && canOverwrite)" disabled="@(!canOverwrite)" />
                        <label class="form-check-label" for="overwrite">Ghi đè — thêm @Model.NewCount dòng mới, cập nhật @Model.DuplicateCount dòng trùng</label>
                    </div>
                </fieldset>
            }
            else
            {
                <input type="hidden" name="mode" value="Append" />
            }
            @if (Model.Valid > 0 && (!Model.CanAppend || (Model.DuplicateCount > 0 && !Model.CanOverwrite)))
            {
                <div class="alert alert-warning">Một số chế độ nhập bị khoá vì bạn thiếu quyền Thêm hoặc Sửa đối với loại dữ liệu này.</div>
            }
            <button type="submit" class="btn btn-primary" disabled="@(!canSubmit)">Xác nhận nhập dữ liệu</button>
            <a asp-action="Index" asp-route-entity="@Model.Entity" class="btn btn-secondary">Huỷ</a>
        </form>
    </div>
</section>
