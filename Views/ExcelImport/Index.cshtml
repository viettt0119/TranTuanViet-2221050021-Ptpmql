@model DemoMVC.Models.ExcelImportResult
@{
    ViewData["Title"] = "Nhập dữ liệu Excel";
}
<section class="list-page">
    <div class="page-heading">
        <div><span class="page-eyebrow">DATA IMPORT</span><h1>Nhập dữ liệu từ Excel</h1></div>
    </div>
    <form asp-action="Import" method="post" enctype="multipart/form-data" class="list-card p-4">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-3">
            <label class="form-label" for="entity">Loại dữ liệu</label>
            <select id="entity" name="entity" class="form-select">
                <option value="department">Khoa</option>
                <option value="employee">Nhân viên</option>
                <option value="product">Sản phẩm</option>
                <option value="student">Sinh viên</option>
                @if (User.IsInRole("Admin"))
                {
                    <option value="rolepermission">Phân quyền vai trò</option>
                }
            </select>
        </div>
        <div class="d-flex flex-wrap gap-2 mb-3">
            <a asp-action="DownloadTemplate" asp-route-entity="department" class="btn btn-outline-secondary">Mẫu Khoa</a>
            <a asp-action="DownloadTemplate" asp-route-entity="employee" class="btn btn-outline-secondary">Mẫu Nhân viên</a>
            <a asp-action="DownloadTemplate" asp-route-entity="product" class="btn btn-outline-secondary">Mẫu Sản phẩm</a>
            <a asp-action="DownloadTemplate" asp-route-entity="student" class="btn btn-outline-secondary">Mẫu Sinh viên</a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="DownloadTemplate" asp-route-entity="rolepermission" class="btn btn-outline-secondary">Mẫu Phân quyền vai trò</a>
            }
        </div>
        <div class="mb-3">
            <label class="form-label" for="file">File Excel (.xlsx)</label>
            <input id="file" name="file" type="file" accept=".xlsx" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Tải lên để xem trước</button>
    </form>
    @if (Model.SuccessCount > 0 || Model.ErrorCount > 0)
    {
        <div class="alert alert-info mt-3">Thành công: @Model.SuccessCount dòng; lỗi: @Model.ErrorCount dòng.</div>
        @if (Model.Errors.Count > 0)
        {
            <ul class="alert alert-danger">@foreach (var error in Model.Errors) { <li>@error</li> }</ul>
        }
    }
    <div class="mt-3">
        <p><strong>Mẫu cột Excel:</strong></p>
        <ul>
            <li>Khoa: Mã Khoa | Tên Khoa</li>
            <li>Nhân viên: Mã nhân viên | Họ tên | Ngày vào làm</li>
            <li>Sản phẩm: ID | Tên sản phẩm | Giá</li>
            <li>Sinh viên: Mã sinh viên (để trống để tự sinh; nếu có phải khớp năm/hệ/ngành) | Họ tên | Địa chỉ | Trường | Mã Khoa | Năm | Mã hệ | Mã ngành</li>
            <li>Phân quyền vai trò (chỉ Admin): RoleName | Permission (dạng Controller.Action, vd. Student.Index) | IsGranted (1/0, để trống = 1)</li>
        </ul>
        <p class="text-muted small mb-0">Danh mục quyền (ApplicationPermissions) tự sinh từ các Controller/Action nên không nhập bằng Excel;
            bộ đếm mã sinh viên (StudentCodeCounters) tự đồng bộ khi nhập sinh viên. Các bảng của Identity không thuộc phạm vi nhập.</p>
    </div>
</section>
