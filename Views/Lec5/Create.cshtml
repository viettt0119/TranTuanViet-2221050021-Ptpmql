<h2>@ViewData["PageTitle"]</h2>

<p><strong>ViewBag demo:</strong> @ViewBag.DemoViewBag</p>

<form method="post" asp-controller="Lec5" asp-action="Create">
    <label>Tên đăng nhập:</label>
    <input type="text" name="username" required />
    <br /><br />

    <label>Chọn quyền:</label>
    <select name="role">
        @foreach (var role in ViewBag.RoleList)
        {
            <option value="@role">@role</option>
        }
    </select>
    <br /><br />

    <button type="submit">Tạo tài khoản</button>
</form>

<br />
<a href="/Lec5/Index">Quay lại danh sách</a>



