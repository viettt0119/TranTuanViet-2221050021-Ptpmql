@model DemoMVC.Models.PagedList<Lec5Model>
@{
    var searchQuery = ViewData["SearchQuery"] as string;
    var roleFilter = ViewData["RoleFilter"] as string;
    var roles = ViewBag.RoleList as string[] ?? [];
    ViewData["PagingRouteValues"] = new Dictionary<string, string?> { ["role"] = roleFilter };
    var hasFilter = !string.IsNullOrWhiteSpace(searchQuery) || !string.IsNullOrWhiteSpace(roleFilter);
}
@section Breadcrumb { <partial name="_LessonBreadcrumb" /> }

<section class="list-page" data-crud-list>
    <div class="page-heading">
        <div>
            <span class="page-eyebrow">BÀI 5</span>
            <h1>@ViewBag.Title</h1>
            <p class="mb-0"><strong>ViewData:</strong> @ViewData["DemoViewData"]</p>
            <p class="mb-0"><strong>ViewBag:</strong> @ViewBag.DemoViewBag</p>
        </div>
        <a asp-action="Create" data-modal-url="@Url.Action("Create")" class="btn btn-primary">+ Thêm người dùng mới</a>
    </div>

    <div class="list-toolbar">
        <form asp-action="Index" method="get" class="search-form">
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <label class="visually-hidden" for="lec5-search">Tìm người dùng</label>
            <input id="lec5-search" name="q" value="@searchQuery" class="form-control" placeholder="Tìm theo tên đăng nhập..." />
            <label class="visually-hidden" for="lec5-role">Lọc theo quyền</label>
            <select id="lec5-role" name="role" class="form-select w-auto">
                <option value="">Tất cả quyền</option>
                @foreach (var role in roles)
                {
                    <option value="@role" selected="@(role == roleFilter)">@role</option>
                }
            </select>
            <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
            @if (hasFilter)
            {
                <a asp-action="Index" asp-route-pageSize="@Model.PageSize" data-list-url class="btn btn-link">Xóa lọc</a>
            }
        </form>
    </div>

    <div>
        <div class="table-responsive list-card">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr><th>STT</th><th>Tên đăng nhập</th><th>Quyền truy cập</th><th class="text-end">Thao tác</th></tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr><td colspan="4" class="empty-state">@(hasFilter ? "Không tìm thấy người dùng phù hợp." : "Chưa có người dùng nào.")</td></tr>
                    }
                    else
                    {
                        var stt = (Model.PageIndex - 1) * Model.PageSize + 1;
                        foreach (var user in Model.Items)
                        {
                            <tr>
                                <td>@stt</td>
                                <td class="fw-semibold">@user.Username</td>
                                <td><span class="badge text-bg-secondary">@user.Role</span></td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Details" asp-route-id="@user.Id" data-modal-url="@Url.Action("Details", new { id = user.Id })" class="btn btn-sm btn-outline-info">Chi tiết</a>
                                    <a asp-action="Edit" asp-route-id="@user.Id" data-modal-url="@Url.Action("Edit", new { id = user.Id })" class="btn btn-sm btn-outline-warning">Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@user.Id" data-modal-url="@Url.Action("Delete", new { id = user.Id })" class="btn btn-sm btn-outline-danger">Xóa</a>
                                </td>
                            </tr>
                            stt++;
                        }
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_PagedListFooter", (object)Model)
    </div>
</section>
@await Html.PartialAsync("_CrudModalHost")
