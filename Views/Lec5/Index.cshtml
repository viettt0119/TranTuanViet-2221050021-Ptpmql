@model List<Lec5Model>

<h2>@ViewBag.Title</h2>

<p><strong>ViewData:</strong> @ViewData["DemoViewData"]</p>
<p><strong>ViewBag:</strong> @ViewBag.DemoViewBag</p>


<p>Đây là danh sách người dùng của bạn...</p>

<table border="1" cellpadding="10" cellspacing="0" style="border-collapse: collapse; width: 100%;">
    <thead>
        <tr>
            <th>STT</th>
            <th>Tên đăng nhập</th>
            <th>Quyền truy cập</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model == null || Model.Count == 0)
        {
            <tr>
                <td colspan="4" style="text-align: center;">Chưa có người dùng nào.</td>
            </tr>
        }
        else
        {
            var stt = 1;
            foreach (var user in Model)
            {
                <tr>
                    <td>@stt</td>
                    <td>@user.Username</td>
                    <td>@user.Role</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@user.Id" data-modal-url="@Url.Action("Details", new { id = user.Id })">Chi tiết</a> |
                        <a asp-action="Edit" asp-route-id="@user.Id" data-modal-url="@Url.Action("Edit", new { id = user.Id })">Sửa</a> |
                        <a asp-action="Delete" asp-route-id="@user.Id" data-modal-url="@Url.Action("Delete", new { id = user.Id })">Xóa</a>
                    </td>
                </tr>
                stt++;
            }
        }
    </tbody>
</table>

<br />
<a asp-action="Create" data-modal-url="@Url.Action("Create")">Thêm người dùng mới</a>
<br />

<p> 
     </p>
@await Html.PartialAsync("_CrudModalHost")