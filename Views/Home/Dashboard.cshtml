@model DemoMVC.Models.HomeDashboardViewModel
@inject DemoMVC.Services.PermissionCatalogService PermissionCatalogService
@{
    var isAdmin = User.IsInRole(DemoMVC.Services.SystemRoles.Admin);
    ViewData["Title"] = isAdmin ? "Tổng quan quản trị" : "Tổng quan";
    var canStudent = await PermissionCatalogService.HasAccessAsync(User, "Student.Index");
    var canDepartment = await PermissionCatalogService.HasAccessAsync(User, "Department.Index");
    var canEmployee = await PermissionCatalogService.HasAccessAsync(User, "Employee.Index");
    var canProduct = await PermissionCatalogService.HasAccessAsync(User, "Product.Index");
}
<div class="d-flex justify-content-between align-items-start mb-4">
    <div class="text-break">
        <span class="page-eyebrow">CỔNG QUẢN LÝ</span>
        @if (isAdmin)
        {
            <h1>Tổng quan quản trị</h1>
            <p class="text-muted mb-0">Xin chào, @User.Identity?.Name. Theo dõi nhanh các khu vực dữ liệu.</p>
        }
        else
        {
            <h1>Xin chào, @User.Identity?.Name</h1>
            <p class="text-muted mb-0">Theo dõi nhanh các khu vực dữ liệu.</p>
        }
    </div>
</div>
@if (!(canStudent || canDepartment || canEmployee || canProduct))
{
    <div class="card p-4 mb-4">
        <p class="mb-3">Tài khoản của bạn chưa được cấp quyền xem khu vực dữ liệu nào.</p>
        <div><a asp-controller="Account" asp-action="Profile" class="btn btn-primary"><i class="bi bi-person-circle me-2"></i>Tài khoản của tôi</a></div>
    </div>
}
<div class="row g-3 mb-4">
    @if (canStudent) { <div class="col-sm-6 col-xl-3"><a asp-controller="Student" asp-action="Index" class="card text-decoration-none p-3 h-100"><i class="bi bi-person-badge fs-3 text-primary"></i><div class="fs-3 fw-bold mt-2">@Model.StudentCount</div><div class="text-muted">Sinh viên</div></a></div> }
    @if (canDepartment) { <div class="col-sm-6 col-xl-3"><a asp-controller="Department" asp-action="Index" class="card text-decoration-none p-3 h-100"><i class="bi bi-buildings fs-3 text-primary"></i><div class="fs-3 fw-bold mt-2">@Model.DepartmentCount</div><div class="text-muted">Khoa</div></a></div> }
    @if (canEmployee) { <div class="col-sm-6 col-xl-3"><a asp-controller="Employee" asp-action="Index" class="card text-decoration-none p-3 h-100"><i class="bi bi-people fs-3 text-primary"></i><div class="fs-3 fw-bold mt-2">@Model.EmployeeCount</div><div class="text-muted">Nhân viên</div></a></div> }
    @if (canProduct) { <div class="col-sm-6 col-xl-3"><a asp-controller="Product" asp-action="Index" class="card text-decoration-none p-3 h-100"><i class="bi bi-box-seam fs-3 text-primary"></i><div class="fs-3 fw-bold mt-2">@Model.ProductCount</div><div class="text-muted">Sản phẩm</div></a></div> }
</div>
