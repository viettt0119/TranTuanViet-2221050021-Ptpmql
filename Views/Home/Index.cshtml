@model DemoMVC.Models.HomeDashboardViewModel
@inject DemoMVC.Services.PermissionCatalogService PermissionCatalogService
@{
    ViewData["Title"] = "Tổng quan";
}
<div class="d-flex justify-content-between align-items-start mb-4">
    <div><span class="page-eyebrow">CỔNG QUẢN LÝ</span><h1>Xin chào, @User.Identity?.Name</h1><p class="text-muted mb-0">Theo dõi nhanh các khu vực dữ liệu.</p></div>
</div>
<div class="row g-3 mb-4">
    @if (await PermissionCatalogService.HasAccessAsync(User, "Student.View")) { <div class="col-sm-6 col-xl-3"><a asp-controller="Student" asp-action="Index" class="card text-decoration-none p-3 h-100"><i class="bi bi-person-badge fs-3 text-primary"></i><div class="fs-3 fw-bold mt-2">@Model.StudentCount</div><div class="text-muted">Sinh viên</div></a></div> }
    @if (await PermissionCatalogService.HasAccessAsync(User, "Department.View")) { <div class="col-sm-6 col-xl-3"><a asp-controller="Department" asp-action="Index" class="card text-decoration-none p-3 h-100"><i class="bi bi-buildings fs-3 text-primary"></i><div class="fs-3 fw-bold mt-2">@Model.DepartmentCount</div><div class="text-muted">Khoa</div></a></div> }
    @if (await PermissionCatalogService.HasAccessAsync(User, "Employee.View")) { <div class="col-sm-6 col-xl-3"><a asp-controller="Employee" asp-action="Index" class="card text-decoration-none p-3 h-100"><i class="bi bi-people fs-3 text-primary"></i><div class="fs-3 fw-bold mt-2">@Model.EmployeeCount</div><div class="text-muted">Nhân viên</div></a></div> }
    @if (await PermissionCatalogService.HasAccessAsync(User, "Product.View")) { <div class="col-sm-6 col-xl-3"><a asp-controller="Product" asp-action="Index" class="card text-decoration-none p-3 h-100"><i class="bi bi-box-seam fs-3 text-primary"></i><div class="fs-3 fw-bold mt-2">@Model.ProductCount</div><div class="text-muted">Sản phẩm</div></a></div> }
</div>
