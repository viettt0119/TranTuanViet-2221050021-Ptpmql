@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Hệ thống Quản lý Sinh viên HUMG";
}

<header class="landing-header">
    <a class="landing-brand" asp-controller="Home" asp-action="Index">
        <span class="landing-brand-mark"><i class="bi bi-mortarboard-fill"></i></span>
        <span>
            <strong>HUMG</strong>
            <small>Đại học Mỏ - Địa chất</small>
        </span>
    </a>
    <nav class="landing-nav" aria-label="Điều hướng chính">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-primary" asp-controller="Home" asp-action="Dashboard">Vào hệ thống</a>
        }
        else
        {
            <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">Đăng nhập</a>
            <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Đăng ký</a>
        }
    </nav>
</header>

<main class="portal-page">
    <div class="portal-intro-grid">
        <section class="portal-hero" aria-labelledby="landing-title">
            <span class="portal-kicker">CỔNG THÔNG TIN SINH VIÊN HUMG</span>
            <h1 id="landing-title">Hệ thống Quản lý Sinh viên</h1>
            <p>
                Nền tảng hỗ trợ quản lý thông tin sinh viên và các hoạt động đào tạo
                tại Trường Đại học Mỏ - Địa chất.
            </p>
            <div class="landing-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn btn-light btn-lg" asp-controller="Home" asp-action="Dashboard">
                        Vào hệ thống <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                }
                else
                {
                    <a class="btn btn-light btn-lg" asp-controller="Account" asp-action="Login">
                        Đăng nhập hệ thống <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                    <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Register">Tạo tài khoản</a>
                }
            </div>
        </section>

        <aside class="portal-guide" aria-labelledby="guide-title">
            <div class="portal-guide-heading">
                <span class="portal-guide-icon"><i class="bi bi-info-circle"></i></span>
                <div>
                    <span class="portal-kicker">BẮT ĐẦU</span>
                    <h2 id="guide-title">Truy cập cổng sinh viên</h2>
                </div>
            </div>
            <ol>
                <li><span>01</span><p><strong>Đăng nhập</strong><br />Sử dụng tài khoản được cấp để truy cập hệ thống.</p></li>
                <li><span>02</span><p><strong>Quản lý thông tin</strong><br />Tra cứu và cập nhật dữ liệu theo quyền được phân công.</p></li>
                <li><span>03</span><p><strong>Cần tài khoản?</strong><br />Đăng ký tài khoản mới và xác thực qua email.</p></li>
            </ol>
        </aside>
    </div>

    <section aria-labelledby="features-title">
        <div class="portal-section-heading">
            <div>
                <span class="portal-kicker">MỘT CỔNG THÔNG TIN TẬP TRUNG</span>
                <h2 id="features-title">Đồng hành cùng công tác đào tạo</h2>
            </div>
            <span class="portal-secure-label"><i class="bi bi-shield-check me-1"></i> Truy cập an toàn</span>
        </div>
        <div class="portal-module-grid">
            <article class="portal-module-card">
                <span class="portal-module-icon portal-icon-blue"><i class="bi bi-person-vcard fs-4"></i></span>
                <span class="portal-module-copy"><strong>Hồ sơ sinh viên</strong><small>Thông tin cá nhân và mã sinh viên được quản lý tập trung.</small></span>
            </article>
            <article class="portal-module-card">
                <span class="portal-module-icon portal-icon-purple"><i class="bi bi-building fs-4"></i></span>
                <span class="portal-module-copy"><strong>Khoa và đào tạo</strong><small>Hỗ trợ tổ chức dữ liệu theo khoa và các đơn vị đào tạo.</small></span>
            </article>
            <article class="portal-module-card">
                <span class="portal-module-icon portal-icon-green"><i class="bi bi-person-lock fs-4"></i></span>
                <span class="portal-module-copy"><strong>Tài khoản bảo mật</strong><small>Xác thực email và phân quyền truy cập theo nhiệm vụ.</small></span>
            </article>
            <article class="portal-module-card">
                <span class="portal-module-icon portal-icon-orange"><i class="bi bi-headset fs-4"></i></span>
                <span class="portal-module-copy"><strong>Hỗ trợ sử dụng</strong><small>Liên hệ đơn vị quản lý hệ thống khi cần được hỗ trợ.</small></span>
            </article>
        </div>
    </section>
</main>

<footer class="landing-footer">
    <span>Trường Đại học Mỏ - Địa chất (HUMG)</span>
    <span>Hệ thống Quản lý Sinh viên</span>
</footer>
